{
  "name": "shader-garden",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "shaders:check": "node scripts/shaders-check.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm shaders:check && pnpm build && pnpm e2e"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vite-plugin-glsl": "1.6.2",
    "vitest": "5.0.3"
  }
}
